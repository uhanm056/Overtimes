{
  "rules": {
    ".read": false,
    ".write": false,
    "prescasy": {
      "v1": {
        "public": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === '__ADMIN_UID__'",
          "updatedAt": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "months": {
            "$month": {
              ".validate": "$month.matches(/^[0-9]{4}-[0-9]{2}$/) && newData.hasChild('summary')",
              "aggregate": {
                ".validate": "newData.isBoolean() && newData.val() === true"
              },
              "rows": { ".validate": false },
              "comps": { ".validate": false },
              "otherComps": { ".validate": false }
            }
          }
        }
      }
    }
  }
}
